# =====================================================================
# MedLens Environment Configuration Template
# Copy this file to .env and configure your credentials.
# WARNING: NEVER commit your actual .env file or API keys to git.
# =====================================================================

# [REQUIRED] Anthropic Claude API Key for Clinical LLM Features:
# - Structured lab test extraction from raw OCR documents (PDF, JPG, PNG)
# - Non-diagnostic verified patient clinical record summarization
# - Multi-document cross-referencing & conflict detection
# Get your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_ANTHROPIC_API_KEY_HERE

# [OPTIONAL] Anthropic Model Identifier
# Default: claude-3-5-sonnet-20241022 (recommended for optimal clinical extraction accuracy)
# Alternatives: claude-3-5-haiku-20241022, claude-3-opus-20240229
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# [OPTIONAL] Express Backend Server Port
# Default: 3001 (proxied by Vite frontend dev server at port 5173)
PORT=3001
